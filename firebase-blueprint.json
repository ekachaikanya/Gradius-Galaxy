{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile with game progress and commander status",
      "type": "object",
      "properties": {
        "commanderName": {
          "type": "string",
          "description": "Custom callsign of the pilot"
        },
        "highScore": {
          "type": "integer",
          "description": "Highest score recorded by user"
        },
        "storyProgress": {
          "type": "integer",
          "description": "Story mode progress (levels completed)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of modification"
        }
      },
      "required": ["commanderName", "highScore", "storyProgress", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "An entry representing a high score submission",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the pilot"
        },
        "commanderName": {
          "type": "string",
          "description": "Callsign of the pilot"
        },
        "score": {
          "type": "integer",
          "description": "Match score attained"
        },
        "stage": {
          "type": "integer",
          "description": "Story chapter or competitive tier"
        },
        "ghostId": {
          "type": "string",
          "description": "Reference to the match ghost document"
        },
        "difficulty": {
          "type": "string",
          "description": "Difficulty level of the match (EASY, NORMAL, HARD)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of score"
        }
      },
      "required": ["userId", "commanderName", "score", "stage", "ghostId", "createdAt", "difficulty"]
    },
    "GhostData": {
      "title": "GhostData",
      "description": "Compacted performance recording of Vic Viper for online duels",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the pilot"
        },
        "commanderName": {
          "type": "string",
          "description": "Callsign of the pilot"
        },
        "score": {
          "type": "integer",
          "description": "Score attained during the recorded run"
        },
        "ghostFrames": {
          "type": "string",
          "description": "Packed trajectory characters of flight: y,fire,shieldStatus per interval"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of run"
        }
      },
      "required": ["userId", "commanderName", "score", "ghostFrames", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message posted in the live pilots lobby chat",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Author UID"
        },
        "commanderName": {
          "type": "string",
          "description": "Callsign of sender"
        },
        "message": {
          "type": "string",
          "description": "Body text of the message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Posting timestamp"
        }
      },
      "required": ["userId", "commanderName", "message", "createdAt"]
    },
    "Lobby": {
      "title": "Lobby",
      "description": "Real-time competitive multiplayer game lobby",
      "type": "object",
      "properties": {
        "roomName": {
          "type": "string",
          "description": "Custom name of the fight room"
        },
        "chapter": {
          "type": "integer",
          "description": "Story sector chapter to compete on"
        },
        "stageTitle": {
          "type": "string",
          "description": "Story sector title"
        },
        "status": {
          "type": "string",
          "description": "Lobby system state (waiting, playing, finished)"
        },
        "hostId": {
          "type": "string",
          "description": "UID of the lobby host creator"
        },
        "hostName": {
          "type": "string",
          "description": "Callsign of the host"
        },
        "hostScore": {
          "type": "integer",
          "description": "Current live score of host inside gameplay"
        },
        "hostLives": {
          "type": "integer",
          "description": "Current live pilot ship lives remaining"
        },
        "hostY": {
          "type": "integer",
          "description": "Real-time Y coordinate of host pilot"
        },
        "hostReady": {
          "type": "boolean",
          "description": "Ready confirmation status"
        },
        "hostFinished": {
          "type": "boolean",
          "description": "Match complete check"
        },
        "guestId": {
          "type": "string",
          "description": "UID of the challenger player"
        },
        "guestName": {
          "type": "string",
          "description": "Callsign of challenger"
        },
        "guestScore": {
          "type": "integer",
          "description": "Current score of challenger"
        },
        "guestLives": {
          "type": "integer",
          "description": "Challenger remaining pilot lives"
        },
        "guestY": {
          "type": "integer",
          "description": "Real-time Y coordinate of challenger pilot"
        },
        "guestReady": {
          "type": "boolean",
          "description": "Challenger ready check"
        },
        "guestFinished": {
          "type": "boolean",
          "description": "Match complete status"
        },
        "winnerId": {
          "type": "string",
          "description": "Declaired winner UID"
        },
        "winnerName": {
          "type": "string",
          "description": "Callsign of winning pilot"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Lobby creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Lobby modification timestamp"
        }
      },
      "required": [
        "roomName", "chapter", "stageTitle", "status",
        "hostId", "hostName", "hostScore", "hostLives", "hostY", "hostReady", "hostFinished",
        "guestId", "guestName", "guestScore", "guestLives", "guestY", "guestReady", "guestFinished",
        "winnerId", "winnerName", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Path for user profile records"
    },
    "/leaderboard/{scoreId}": {
      "schema": "LeaderboardEntry",
      "description": "Path for public leaderboard entries"
    },
    "/ghosts/{ghostId}": {
      "schema": "GhostData",
      "description": "Stored flight profiles of high scores for online opponent replay"
    },
    "/chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global live combat channel chat log"
    },
    "/lobbies/{lobbyId}": {
      "schema": "Lobby",
      "description": "Paths for real-time competitive match lobbies"
    }
  }
}
